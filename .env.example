# ============================================================
#   m2 MIGHTY MEMORIES — ENVIRONMENT VARIABLES
#   Copy this file to .env and fill in your actual values.
#   NEVER share this file publicly or commit it to GitHub.
# ============================================================


# ─────────────────────────────────────────────
# 1. ADMIN DASHBOARD PASSWORD
#    Used to log in at /mightymemoriesadmin
# ─────────────────────────────────────────────
ADMIN_PASSWORD="admin123"
# ↑ Change this to a strong password for your business account!


# ─────────────────────────────────────────────
# 2. EMAIL (SMTP) — For sending order notifications
#    Currently set up with Gmail App Password.
#    To change to your business email:
#      Step 1: Go to myaccount.google.com → Security → App Passwords
#      Step 2: Generate a new App Password for your business Gmail
#      Step 3: Replace SMTP_USER and SMTP_PASS below
# ─────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="namrastk@gmail.com"
#             ↑ Replace with your business Gmail
SMTP_PASS="lpbkiaxadklofixh"
#             ↑ Replace with the new Gmail App Password (no spaces)
SMTP_FROM="\"Mighty Memories Orders\" <namrastk@gmail.com>"
#                                       ↑ Replace with your business Gmail


# ─────────────────────────────────────────────
# 3. GOOGLE LOGIN (OAuth) — For customer "Sign in with Google"
#    Currently using credentials from your personal Google Cloud project.
#    To change to your business account:
#      Step 1: Go to console.cloud.google.com using your business Google account
#      Step 2: Create a new project → APIs & Services → Credentials → OAuth 2.0
#      Step 3: Replace CLIENT_ID and CLIENT_SECRET below
# ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
#              ↑ Change to your live website URL when deployed (e.g. https://mightymemories.vercel.app)

NEXTAUTH_SECRET="mighty-memories-super-secret-key-change-in-production"
#                 ↑ Change to a long random string in production. Generate one at: https://generate-secret.vercel.app/32

GOOGLE_CLIENT_ID="your_google_client_id_here"
#                  ↑ Replace with your business Google Cloud Client ID
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
#                      ↑ Replace with your business Google Cloud Client Secret


# ─────────────────────────────────────────────
# 4. DATABASE — (For cloud deployment only)
#    When deploying to Vercel + Neon (cloud hosting):
#      Step 1: Create a free project at neon.tech
#      Step 2: Copy the "Connection String" from Neon dashboard
#      Step 3: Uncomment and fill in DATABASE_URL below
# ─────────────────────────────────────────────
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
#               ↑ Paste your Neon connection string here


# ─────────────────────────────────────────────
# 5. CLOUDINARY — (For cloud photo storage, when going live)
#    When deploying to production, photos are stored on Cloudinary (free).
#      Step 1: Create a free account at cloudinary.com
#      Step 2: Go to your Cloudinary Dashboard
#      Step 3: Copy Cloud Name, API Key, and API Secret below
# ─────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
